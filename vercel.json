{
  "git": {
    "deploymentEnabled": { "main": false, "codex/railway-*": false }
  },
  "buildCommand": "npm run vercel-build",
  "functions": {
    "src/app/api/queues/applications/route.ts": {
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "ir35-application-kicks", "maxConcurrency": 2 }]
    }
  },
  "crons": [
    {
      "path": "/api/pipeline/fetch",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/automation/run",
      "schedule": "15 6 * * *"
    }
  ]
}
