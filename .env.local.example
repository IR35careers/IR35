# IR35Careers Environment Variables
# Copy this file to .env.local and fill in the values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Server-side secrets (NEVER prefix these with NEXT_PUBLIC_) ──────────
# Supabase secret key (sb_secret_...) from Supabase → Settings → API Keys.
# Used only by server code: the job-fetch pipeline writes to the jobs table
# with this key. It must also be added to Vercel → Settings → Environment
# Variables for production.
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Shared secret protecting the pipeline trigger endpoint. Make up a long
# random string (30+ characters). Vercel Cron automatically sends it as a
# Bearer token; you can also trigger manually in a browser:
# Manual trigger: send `Authorization: Bearer YOUR_VALUE` to
#   https://ir35careers.com/api/pipeline/fetch
CRON_SECRET=make_up_a_long_random_string

# ── Job-board aggregator APIs (the main source of contract jobs) ────────
# Reed.co.uk — free API key, instant signup:
#   https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=your_reed_api_key

# Adzuna — free app credentials, instant signup:
#   https://developer.adzuna.com
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Optional: Site URL for production
NEXT_PUBLIC_SITE_URL=https://ir35careers.com

# ── Public legal identity (required before paid checkout) ───────────────
# Use the operator's real legal name and service/registered address. These
# values are intentionally public and appear in legal disclosures.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_COMPANY_NUMBER=
NEXT_PUBLIC_VAT_NUMBER=
NEXT_PUBLIC_ICO_NUMBER=

# ── Feature gates (safe defaults) ──────────────────────────────────────────
# Application preparation is available locally. External side effects remain
# off until provider-specific sandbox and approval checks are complete.
ENABLE_APPLICATION_PREP=true
ENABLE_APPLICATION_SUBMISSION=false
# Managed one-click application API. Server-only. Applications are charged by
# the provider only when submitted; keep the feature flag off until a funded
# key and production data-processing terms are approved.
TSENTA_API_KEY=
ENABLE_INBOUND_MAIL=false
ENABLE_WELCOME_EMAIL=false
ENABLE_WAITLIST_LAUNCH_EMAIL=false
ENABLE_BILLING=false
BILLING_RELEASE_APPROVED=false

# Enhanced role-specific CV wording through OpenRouter. The local evidence
# engine remains available without this key. These values are server-only:
# never add NEXT_PUBLIC_ and never paste the key into the UI.
# Configure a hard spend limit in OpenRouter before enabling production use.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Per signed-in user, per warm server instance. Also set a hard spend limit in
# OpenRouter because an application-level limiter is not a billing guarantee.
OPENROUTER_REQUESTS_PER_USER_PER_HOUR=5

# Resend inbound recruiter email. Use a separate Full access key for the app;
# the sending-only key configured inside Supabase Auth must remain separate.
# Never expose these as NEXT_PUBLIC_*.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
EMAIL_REPLY_TO=
INBOUND_EMAIL_DOMAIN=mail.ir35careers.com
# Set ENABLE_WELCOME_EMAIL=true only after migration 014 is applied and the
# Resend API key has sending access. EMAIL_FROM defaults to the verified sender
# IR35Careers <hello@mail.ir35careers.com> when left blank.
# Resend sends signed email.received events to:
# https://www.ir35careers.com/api/integrations/email/inbound
# Legacy aliases accepted during provider migration:
EMAIL_PROVIDER_API_KEY=
INBOUND_MAIL_SIGNING_SECRET=

# Authorised application-submission gateway. The gateway must accept the
# documented JSON contract, honour the Idempotency-Key header and return a
# unique submission_id or receipt_id. Keep disabled until sandbox acceptance.
APPLICATION_SUBMISSION_PROVIDER_URL=
APPLICATION_SUBMISSION_PROVIDER_API_KEY=
APPLICATION_SUBMISSION_PROVIDER_NAME=
# A browser-automation gateway is required for third-party ATS forms where
# IR35Careers is not the employer and therefore does not own ATS API keys.
# CAPTCHA and legal or demographic questions must return to the user.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Stripe Billing. Run migration 011, configure a recurring GBP price and test
# the complete sandbox flow before switching ENABLE_BILLING to true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
# Public display copy, for example "£19/month including VAT". It must match
# the configured Stripe price and pre-contract information.
NEXT_PUBLIC_PRO_PLAN_PRICE_LABEL=
# Pipe-separated, approved and currently delivered benefits; 2-6 entries.
# Do not list future provider features. Example:
# NEXT_PUBLIC_PRO_PLAN_FEATURES=100 monitored roles|Priority workspace exports
NEXT_PUBLIC_PRO_PLAN_FEATURES=
# Legacy aliases remain accepted during migration:
BILLING_PROVIDER_SECRET_KEY=
BILLING_WEBHOOK_SECRET=

# Accounts permitted to use the server-protected admin API.
ADMIN_EMAILS=you@example.com
# Random secret with at least 32 characters. Used to sign the separate,
# HttpOnly, 20-minute admin session. Keep it server-side and rotate it if
# administrator access may have been exposed.
ADMIN_SESSION_SECRET=replace_with_a_cryptographically_random_secret
