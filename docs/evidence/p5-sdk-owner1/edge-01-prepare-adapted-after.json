{
  "admin": {
    "config": {
      "persist": false
    },
    "disabled": true
  },
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "headers",
                          "response": {
                            "set": {
                              "X-Robots-Tag": [
                                "noindex, nofollow, noarchive"
                              ]
                            }
                          }
                        },
                        {
                          "handler": "headers",
                          "response": {
                            "set": {
                              "Cache-Control": [
                                "no-store"
                              ]
                            }
                          }
                        },
                        {
                          "handler": "headers",
                          "response": {
                            "deferred": true,
                            "set": {
                              "X-Robots-Tag": [
                                "noindex, nofollow, noarchive"
                              ]
                            }
                          }
                        },
                        {
                          "handler": "headers",
                          "response": {
                            "deferred": true,
                            "set": {
                              "Cache-Control": [
                                "no-store"
                              ]
                            }
                          }
                        },
                        {
                          "handler": "headers",
                          "response": {
                            "set": {
                              "X-Caddy-Request-Id": [
                                "{http.request.uuid}"
                              ]
                            }
                          }
                        },
                        {
                          "handler": "headers",
                          "response": {
                            "deferred": true,
                            "set": {
                              "X-Caddy-Request-Id": [
                                "{http.request.uuid}"
                              ]
                            }
                          }
                        },
                        {
                          "handler": "headers",
                          "response": {
                            "deferred": true,
                            "delete": [
                              "Server"
                            ]
                          }
                        },
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "handler": "vars",
                                  "original_auth": ""
                                }
                              ]
                            },
                            {
                              "handle": [
                                {
                                  "handler": "vars",
                                  "original_auth": "{http.request.header.Authorization}"
                                }
                              ],
                              "match": [
                                {
                                  "header": {
                                    "Authorization": [
                                      "Bearer *"
                                    ]
                                  }
                                }
                              ]
                            },
                            {
                              "handle": [
                                {
                                  "handler": "headers",
                                  "request": {
                                    "set": {
                                      "Authorization": [
                                        "{http.request.header.X-Staging-Authorization}"
                                      ]
                                    }
                                  }
                                }
                              ],
                              "match": [
                                {
                                  "header": {
                                    "X-Staging-Authorization": [
                                      "*"
                                    ]
                                  }
                                }
                              ]
                            },
                            {
                              "handle": [
                                {
                                  "handler": "headers",
                                  "response": {
                                    "set": {
                                      "X-Ir35-Matched-Route": [
                                        "api-basic-rejection"
                                      ]
                                    }
                                  }
                                },
                                {
                                  "handler": "authentication",
                                  "providers": {
                                    "http_basic": {
                                      "accounts": [
                                        {
                                          "password": "<existing-staging-bcrypt>",
                                          "username": "ir35"
                                        }
                                      ],
                                      "hash": {
                                        "algorithm": "bcrypt"
                                      },
                                      "hash_cache": {}
                                    }
                                  }
                                },
                                {
                                  "handler": "headers",
                                  "request": {
                                    "delete": [
                                      "Authorization"
                                    ]
                                  }
                                }
                              ]
                            },
                            {
                              "handle": [
                                {
                                  "handler": "headers",
                                  "request": {
                                    "set": {
                                      "Authorization": [
                                        "{http.vars.original_auth}"
                                      ]
                                    }
                                  }
                                }
                              ],
                              "match": [
                                {
                                  "expression": {
                                    "expr": "{http.vars.original_auth} != \"\"",
                                    "name": "restore_bearer"
                                  }
                                }
                              ]
                            },
                            {
                              "handle": [
                                {
                                  "handler": "headers",
                                  "request": {
                                    "delete": [
                                      "X-Staging-Authorization"
                                    ]
                                  }
                                }
                              ]
                            },
                            {
                              "handle": [
                                {
                                  "handler": "headers",
                                  "response": {
                                    "set": {
                                      "X-Ir35-Matched-Route": [
                                        "api-proxy"
                                      ]
                                    }
                                  }
                                },
                                {
                                  "handler": "reverse_proxy",
                                  "headers": {
                                    "request": {
                                      "delete": [
                                        "X-Forwarded-For",
                                        "X-Real-IP",
                                        "X-Vercel-Forwarded-For"
                                      ]
                                    }
                                  },
                                  "upstreams": [
                                    {
                                      "dial": "ir35-p5-kong:8000"
                                    }
                                  ]
                                }
                              ],
                              "match": [
                                {
                                  "path": [
                                    "/auth/v1/*",
                                    "/rest/v1/*",
                                    "/storage/v1/*",
                                    "/realtime/v1/*"
                                  ]
                                }
                              ]
                            },
                            {
                              "handle": [
                                {
                                  "handler": "headers",
                                  "response": {
                                    "set": {
                                      "X-Ir35-Matched-Route": [
                                        "api-fallback"
                                      ]
                                    }
                                  }
                                },
                                {
                                  "body": "Not found",
                                  "handler": "static_response",
                                  "status_code": 404
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "body": "Forbidden",
                          "handler": "static_response",
                          "status_code": 403
                        }
                      ],
                      "match": [
                        {
                          "not": [
                            {
                              "remote_ip": {
                                "ranges": [
                                  "80.76.195.222/32",
                                  "132.145.28.134",
                                  "127.0.0.1",
                                  "::1",
                                  "172.30.35.1",
                                  "172.30.35.3"
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "api-staging.ir35careers.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "headers",
                          "response": {
                            "set": {
                              "X-Robots-Tag": [
                                "noindex, nofollow, noarchive"
                              ]
                            }
                          }
                        },
                        {
                          "handler": "headers",
                          "response": {
                            "set": {
                              "Cache-Control": [
                                "no-store"
                              ]
                            }
                          }
                        },
                        {
                          "handler": "headers",
                          "response": {
                            "deferred": true,
                            "set": {
                              "X-Robots-Tag": [
                                "noindex, nofollow, noarchive"
                              ]
                            }
                          }
                        },
                        {
                          "handler": "headers",
                          "response": {
                            "deferred": true,
                            "set": {
                              "Cache-Control": [
                                "no-store"
                              ]
                            }
                          }
                        },
                        {
                          "handler": "headers",
                          "response": {
                            "set": {
                              "X-Caddy-Request-Id": [
                                "{http.request.uuid}"
                              ]
                            }
                          }
                        },
                        {
                          "handler": "headers",
                          "response": {
                            "deferred": true,
                            "set": {
                              "X-Caddy-Request-Id": [
                                "{http.request.uuid}"
                              ]
                            }
                          }
                        },
                        {
                          "handler": "headers",
                          "response": {
                            "deferred": true,
                            "delete": [
                              "Server"
                            ]
                          }
                        },
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "group": "group4",
                              "handle": [
                                {
                                  "handler": "subroute",
                                  "routes": [
                                    {
                                      "handle": [
                                        {
                                          "handler": "subroute",
                                          "routes": [
                                            {
                                              "handle": [
                                                {
                                                  "handler": "headers",
                                                  "response": {
                                                    "deferred": true,
                                                    "set": {
                                                      "X-Ir35-Matched-Route": [
                                                        "sdk-guard"
                                                      ]
                                                    }
                                                  }
                                                },
                                                {
                                                  "body": "Staging authentication required",
                                                  "handler": "static_response",
                                                  "status_code": 401
                                                }
                                              ],
                                              "match": [
                                                {
                                                  "not": [
                                                    {
                                                      "header_regexp": {
                                                        "Cookie": {
                                                          "pattern": "(^|;[ ]*)__Host-ir35-staging=<existing-staging-gate>(;|$)"
                                                        }
                                                      }
                                                    }
                                                  ]
                                                }
                                              ]
                                            },
                                            {
                                              "handle": [
                                                {
                                                  "handler": "rewrite",
                                                  "strip_path_prefix": "/supabase"
                                                }
                                              ]
                                            },
                                            {
                                              "handle": [
                                                {
                                                  "handler": "headers",
                                                  "response": {
                                                    "set": {
                                                      "X-Ir35-Matched-Route": [
                                                        "sdk-proxy"
                                                      ]
                                                    }
                                                  }
                                                },
                                                {
                                                  "handler": "reverse_proxy",
                                                  "headers": {
                                                    "request": {
                                                      "delete": [
                                                        "Cookie",
                                                        "X-Forwarded-For",
                                                        "X-Real-IP",
                                                        "X-Vercel-Forwarded-For"
                                                      ]
                                                    }
                                                  },
                                                  "upstreams": [
                                                    {
                                                      "dial": "ir35-p5-kong:8000"
                                                    }
                                                  ]
                                                }
                                              ],
                                              "match": [
                                                {
                                                  "path": [
                                                    "/auth/v1/*",
                                                    "/rest/v1/*",
                                                    "/storage/v1/*",
                                                    "/realtime/v1/*"
                                                  ]
                                                }
                                              ]
                                            },
                                            {
                                              "handle": [
                                                {
                                                  "handler": "headers",
                                                  "response": {
                                                    "set": {
                                                      "X-Ir35-Matched-Route": [
                                                        "sdk-fallback"
                                                      ]
                                                    }
                                                  }
                                                },
                                                {
                                                  "body": "Not found",
                                                  "handler": "static_response",
                                                  "status_code": 404
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ],
                              "match": [
                                {
                                  "path": [
                                    "/supabase/*"
                                  ]
                                }
                              ]
                            },
                            {
                              "group": "group4",
                              "handle": [
                                {
                                  "handler": "subroute",
                                  "routes": [
                                    {
                                      "handle": [
                                        {
                                          "handler": "subroute",
                                          "routes": [
                                            {
                                              "handle": [
                                                {
                                                  "handler": "headers",
                                                  "response": {
                                                    "set": {
                                                      "X-Ir35-Matched-Route": [
                                                        "basic-auth-rejection"
                                                      ]
                                                    }
                                                  }
                                                },
                                                {
                                                  "handler": "authentication",
                                                  "providers": {
                                                    "http_basic": {
                                                      "accounts": [
                                                        {
                                                          "password": "<existing-staging-bcrypt>",
                                                          "username": "ir35"
                                                        }
                                                      ],
                                                      "hash": {
                                                        "algorithm": "bcrypt"
                                                      },
                                                      "hash_cache": {}
                                                    }
                                                  }
                                                },
                                                {
                                                  "handler": "headers",
                                                  "response": {
                                                    "deferred": true,
                                                    "set": {
                                                      "Set-Cookie": [
                                                        "__Host-ir35-staging=<existing-staging-gate>; Path=/; Secure; HttpOnly; SameSite=Strict; Max-Age=1800"
                                                      ]
                                                    }
                                                  }
                                                }
                                              ]
                                            },
                                            {
                                              "handle": [
                                                {
                                                  "handler": "headers",
                                                  "request": {
                                                    "delete": [
                                                      "Authorization"
                                                    ]
                                                  }
                                                }
                                              ],
                                              "match": [
                                                {
                                                  "header": {
                                                    "Authorization": [
                                                      "Basic *"
                                                    ]
                                                  }
                                                }
                                              ]
                                            },
                                            {
                                              "handle": [
                                                {
                                                  "handler": "headers",
                                                  "response": {
                                                    "set": {
                                                      "X-Ir35-Matched-Route": [
                                                        "page-proxy"
                                                      ]
                                                    }
                                                  }
                                                },
                                                {
                                                  "handler": "reverse_proxy",
                                                  "headers": {
                                                    "request": {
                                                      "delete": [
                                                        "X-Forwarded-For",
                                                        "X-Real-IP",
                                                        "X-Vercel-Forwarded-For"
                                                      ]
                                                    }
                                                  },
                                                  "upstreams": [
                                                    {
                                                      "dial": "ir35-p5-web:3000"
                                                    }
                                                  ]
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "body": "Forbidden",
                          "handler": "static_response",
                          "status_code": 403
                        }
                      ],
                      "match": [
                        {
                          "not": [
                            {
                              "remote_ip": {
                                "ranges": [
                                  "80.76.195.222/32",
                                  "132.145.28.134",
                                  "127.0.0.1",
                                  "::1",
                                  "172.30.35.1",
                                  "172.30.35.3"
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "staging.ir35careers.com"
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "ca": "https://acme-v02.api.letsencrypt.org/directory",
                "challenges": {
                  "tls-alpn": {
                    "disabled": true
                  }
                },
                "email": "info@ir35careers.com",
                "module": "acme"
              }
            ],
            "subjects": [
              "api-staging.ir35careers.com",
              "staging.ir35careers.com"
            ]
          }
        ]
      }
    }
  },
  "logging": {
    "logs": {
      "default": {
        "level": "ERROR"
      }
    }
  },
  "storage": {
    "module": "file_system",
    "root": "/data"
  }
}
