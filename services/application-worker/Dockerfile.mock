FROM mcr.microsoft.com/playwright:v1.61.0-noble@sha256:57b65fdc9ceabe0ef613124c7bbe2babcf9362c4d85e382fe3b03604e84b428a
WORKDIR /app
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts && node -e "if(require('playwright-core/package.json').version!=='1.61.0')throw new Error('Pinned browser version mismatch')"
COPY tsconfig.json ./
COPY src ./src
COPY services/application-worker ./services/application-worker
COPY supabase/operations/pgboss-producer-grants.sql ./supabase/operations/pgboss-producer-grants.sql
ENV NODE_ENV=production HOME=/tmp/ir35-home PORT=8787
USER 1002:1002
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 CMD node -e "fetch('http://127.0.0.1:8787/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "--import", "tsx", "services/application-worker/mock-main.ts", "--run"]
