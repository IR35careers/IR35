# Preparation only. No real credentials belong in this file or a browser bundle.
# Web default: keep vercel until the Railway worker has passed the cutover gates.
APPLY_RUNNER=vercel

# Railway: set APPLY_RUNNER=railway. Start in standby; enable after web cutover.
APPLICATION_WORKER_ACCEPT_JOBS=false
APPLICATION_WORKER_CONCURRENCY=1
APPLICATION_WORKER_VERSION=railway-prepared
IR35CAREERS_APP_URL=https://www.ir35careers.com
APPLICATION_WORKER_SECRET=

# BOTH web producer and worker: separate private queue schema, session pooler only.
# Copy the actual regional Session pooler URL from Supabase Connect.
# postgres://ROLE.PROJECT_REF:URL_ENCODED_PASSWORD@REGION.pooler.supabase.com:5432/postgres
PG_BOSS_DATABASE_URL=
# Optional trusted CA PEM, literal newlines or escaped \n. TLS verification stays on.
PG_BOSS_SSL_CA=
# CI only: PG_BOSS_LOCAL_TEST=true also requires NODE_ENV=test and a loopback
# database host. Never enable it in deployed worker or Vercel environments.

# Worker consumer only (not needed for queue setup or standby health).
NEXT_PUBLIC_SUPABASE_URL=https://kxcbgflleqnjzjbkevwd.supabase.co
SUPABASE_SECRET_KEY=
# Same >=32-character cron/scheduler signing secret as Vercel.
CRON_SECRET=
# Enable only after the numeric migration was installed (done in current prod).
JOB_DECIMAL_RATES_ENABLED=true

# Optional ingestion providers; missing keys produce visible skipped-source notes.
REED_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional field-label mapping (deterministic mapping works without it).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Optional: restrict native runner employer hosts. Empty uses existing HTTPS/SSRF checks.
APPLICATION_RUNNER_ALLOWED_HOSTS=
# Scheduler batch limit, existing daily cap logic still applies.
AUTO_APPLY_DAILY_BATCH_LIMIT=25

# Container defaults / Railway-provided settings. No browser path override needed.
NODE_ENV=production
PORT=8787
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=330
# Worker enforces headless and a 300s browser budget; executable comes from the
# image's matching playwright-core version. Do not copy local Windows paths.

# Web only: retain existing APPLICATION_WORKER_ENABLED=true, shared
# APPLICATION_WORKER_SECRET and submission gates. Railway uses the signed web
# control plane for approved packets/callbacks; moving all privileged web reads
# into worker-scoped commands is a separate Phase 0/4 migration, not done here.
