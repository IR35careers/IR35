# Preparation only. No real credentials belong in this file or a browser bundle.
# Web AND standby worker: keep vercel until literal YES CUTOVER.
APPLY_RUNNER=vercel

# Oracle app only: defaults leave Vercel behaviour unchanged. Private Kong URL
# never enters browser bundles. Public Supabase URL still generates public links.
SUPABASE_INTERNAL_URL=
IR35_STAGING=false
IR35_READ_ONLY=false
IR35_SESSION_MIGRATED=false
IR35_BUILD_SHA=
IR35_WORKER_HEALTH_ENABLED=false
IR35_REALTIME_HEALTH_ENABLED=false
IR35_PUBLIC_HTML_CACHE=false
IR35_WEB_HOST=
IR35_SCHEDULER_ENABLED=false

# Web: free Google Identity Services. Public OAuth web client ID, never its secret.
# Authorise the exact www/apex/admin and approved preview JavaScript origins in
# Google Cloud; Supabase Google provider must accept this ID and check the nonce.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Explicit emergency fallback only. GIS remains the primary flow; no auto redirect.
NEXT_PUBLIC_GOOGLE_REDIRECT_FALLBACK_ENABLED=false

# Oracle standby: keep both gates unchanged. Queue aliases oracle/railway are
# supported in code, not authority to change live flags or deploy to Railway.
APPLICATION_WORKER_ACCEPT_JOBS=false
APPLICATION_WORKER_CONCURRENCY=1
APPLICATION_WORKER_VERSION=oracle-prepared
IR35CAREERS_APP_URL=https://www.ir35careers.com
APPLICATION_WORKER_SECRET=
# Updater-only UUID override: normally ABSENT (not blank), never a cutover flag.
# APPLICATION_WORKER_UPDATE_OPERATION is supplied temporarily by the local
# signed updater so a replacement waits for health before polling any queue.

# BOTH web producer and worker: separate private queue schema, session pooler only.
# Copy the actual regional Session pooler URL from Supabase Connect.
# Worker: postgres://ir35_queue.PROJECT_REF:URL_ENCODED_PASSWORD@REGION.pooler.supabase.com:5432/postgres
# Vercel uses ir35_queue_producer.PROJECT_REF, never the owner login.
PG_BOSS_DATABASE_URL=
# Prepared exact-host boundary; async queue integration remains a P6 gate.
# No operational hostnames or credentials belong in this example.
QUEUE_DB_ALLOWED_HOSTS=
# Optional trusted CA PEM, literal newlines or escaped \n. TLS verification stays on.
PG_BOSS_SSL_CA=
# CI only: PG_BOSS_LOCAL_TEST=true also requires NODE_ENV=test and a loopback
# database host. Never enable it in deployed worker or Vercel environments.
# PG_BOSS_PRODUCER_TEST_DATABASE_URL is only for the disposable local-CI
# permission probe; never set it on Oracle, Railway or Vercel.

# Worker consumer only (not needed for queue setup or standby health).
NEXT_PUBLIC_SUPABASE_URL=https://kxcbgflleqnjzjbkevwd.supabase.co
SUPABASE_SECRET_KEY=
# Same >=32-character cron/scheduler signing secret as Vercel.
CRON_SECRET=
# Enable only after the numeric migration was installed (done in current prod).
JOB_DECIMAL_RATES_ENABLED=true

# Optional ingestion providers; missing keys produce visible skipped-source notes.
REED_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional field-label mapping (deterministic mapping works without it).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Optional: restrict native runner employer hosts. Empty uses existing HTTPS/SSRF checks.
APPLICATION_RUNNER_ALLOWED_HOSTS=
# Scheduler batch limit, existing daily cap logic still applies.
AUTO_APPLY_DAILY_BATCH_LIMIT=25

# Container defaults. Oracle exposes this port only on host loopback.
NODE_ENV=production
PORT=8787
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=330
# Oracle Compose ONLY: put this public immutable image reference and the two
# cutover flags in /opt/ir35-worker/deploy.env (infra/oracle/deploy.env.example).
# Never use the raw secret-bearing worker .env for Compose interpolation.
IR35_WORKER_IMAGE=
# Worker enforces headless and a 300s browser budget; executable comes from the
# image's matching playwright-core version. Do not copy local Windows paths.

# Web only: retain existing APPLICATION_WORKER_ENABLED=true, shared
# APPLICATION_WORKER_SECRET and submission gates. The queue worker uses the signed web
# control plane for approved packets/callbacks; moving all privileged web reads
# into worker-scoped commands is a separate Phase 0/4 migration, not done here.
