{
  "name": "ir35careers",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "esbuild": false,
    "unrs-resolver": false
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:legacy": "tsx scripts/test-processing.ts && tsx scripts/test-tax.ts && tsx scripts/test-aggregators.ts && tsx scripts/test-fetchers.ts",
    "test:extension": "node scripts/test-application-assistant.mjs",
    "email:preview": "tsx scripts/render-email-preview.ts",
    "email:audit-launch": "tsx scripts/audit-launch-audience.ts",
    "worker:install-browser": "playwright-core install chromium",
    "worker:build": "esbuild ./services/application-worker/server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --alias:@=./src --outfile=./services/application-worker/dist/server.mjs",
    "worker:start": "npm run worker:build && node --env-file=services/application-worker/.env services/application-worker/dist/server.mjs",
    "worker:railway": "tsx services/application-worker/railway.ts",
    "worker:queue": "tsx services/application-worker/railway.ts",
    "worker:mock-smoke": "tsx services/application-worker/mock-ats-smoke.ts",
    "worker:queue:setup": "tsx services/application-worker/setup-queue.ts",
    "security:source": "node scripts/security-check.mjs",
    "security:audit": "tsx scripts/security-audit.ts",
    "security:signatures": "npm audit signatures",
    "test:e2e": "playwright test",
    "verify:release": "npm run typecheck && npm run lint && npm run test:unit && npm run test:legacy",
    "vercel-build": "npm run verify:release && next build"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  },
  "dependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/queue": "^0.8.0",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "framer-motion": "^11.15.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.1",
    "next": "^16.3.2",
    "pdfkit": "^0.19.1",
    "pg-boss": "12.38.0",
    "playwright-core": "1.61.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.4.1",
    "resend": "^6.22.0",
    "stripe": "^22.5.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.185.1",
    "unpdf": "^1.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "0.5.9",
    "@playwright/test": "1.61.0",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.2",
    "lighthouse": "^13.4.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
