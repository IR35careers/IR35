{
  "name": "ir35careers",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:legacy": "tsx scripts/test-processing.ts && tsx scripts/test-tax.ts && tsx scripts/test-aggregators.ts && tsx scripts/test-fetchers.ts",
    "email:preview": "tsx scripts/render-email-preview.ts",
    "email:audit-launch": "tsx scripts/audit-launch-audience.ts",
    "test:e2e": "playwright test",
    "verify:release": "npm run typecheck && npm run lint && npm run test:unit && npm run test:legacy",
    "vercel-build": "npm run verify:release && next build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "framer-motion": "^11.15.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.1",
    "next": "^16.3.1",
    "pdfkit": "^0.17.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hot-toast": "^2.4.1",
    "resend": "^6.21.0",
    "stripe": "^22.5.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.185.1",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.1",
    "lighthouse": "^13.4.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
